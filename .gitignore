# ESP-IDF build output
build/
build-esp32/

# Generated config (regenerated from sdkconfig.defaults)
sdkconfig
sdkconfig.old

# cmdr-generated dev scripts — regenerate with `cmdr regen`, don't commit.
# They're derived from cmdr's templates, so a committed copy goes stale silently;
# on CMake targets the generator also bakes absolute paths into them.
/bum
/build
/upload
/monitor
/bum-ota

# Build counter (bumped each build by commander_version_stamp; local to each tree)
.build_number

# Managed components (re-fetched from dependencies.lock)
managed_components/

# Secrets — WiFi creds + API keys (copy secrets.h.example → secrets.h)
secrets.h

# Unrelated firmware-dump tooling kept locally
old/

# macOS
.DS_Store

# Local publish-prep notes
PUBLISH_CHECKLIST.md
