#!/bin/bash
set -e
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PORT=""
for i in $(seq 1 20); do
    PORT=$(python3 "$DIR/scripts/find_port.py" esp32 2>/dev/null) && break
    [ $i -eq 1 ] && echo "Waiting for esp32..."
    sleep 0.5
done
[ -n "$PORT" ] || { echo "error: esp32 port did not appear" >&2; exit 1; }
echo "Connecting to $PORT  (Ctrl-T q to quit)"
tio --baudrate 115200 "$PORT"
